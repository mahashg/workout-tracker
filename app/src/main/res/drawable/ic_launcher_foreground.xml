<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher foreground (v2.8): bold white kettlebell silhouette with a small
     green completion-check badge tucked at its lower-right. No text.
     All art stays inside the adaptive-icon safe zone (central ~66%: 18..90). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- handle: tall arc whose feet land on the ball's shoulders, leaving a
         clear blue grip window between the handle and the ball's top -->
    <path
        android:fillColor="#00000000"
        android:pathData="M39.9,51.9 A15,15 0 1 1 68.1,51.9"
        android:strokeWidth="6"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round" />
    <!-- ball -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M34,66 a20,20 0 1,0 40,0 a20,20 0 1,0 -40,0" />
    <!-- green completion badge at the ball's lower-right -->
    <path
        android:fillColor="#22C55E"
        android:pathData="M60,76 a8,8 0 1,0 16,0 a8,8 0 1,0 -16,0" />
    <!-- white check inside the badge -->
    <path
        android:fillColor="#00000000"
        android:pathData="M64.5,76.5 l3,3 l6.5,-7"
        android:strokeWidth="2.2"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
