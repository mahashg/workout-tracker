<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- v3.4: Health Connect — write finished workouts (exercise sessions)
         to the on-device Health Connect store. On-device permission only;
         no account, no network. -->
    <uses-permission android:name="android.permission.health.WRITE_EXERCISE" />
    <!-- Lets the app detect the Health Connect provider (availability
         checks) on devices where package visibility is filtered. -->
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
        <intent>
            <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
        </intent>
    </queries>
    <application android:name=".WtApplication" android:allowBackup="true" android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher_round" android:label="@string/app_name" android:theme="@style/Theme.WorkoutTracker">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity>
        <!-- v3.9: the chooser's two doors. -->
        <activity android:name=".AtHomeActivity" android:exported="false" />
        <activity android:name=".SessionActivity" android:exported="false" />
        <activity android:name=".RoutinesActivity" android:exported="false" />
        <activity android:name=".RoutineEditActivity" android:exported="false" />
        <activity android:name=".ExerciseEditActivity" android:exported="false" />
        <!-- v3.15: the view-only Library entry detail page. -->
        <activity android:name=".ExerciseDetailActivity" android:exported="false" />
        <activity android:name=".HistoryActivity" android:exported="false" />
        <activity android:name=".HistoryDetailActivity" android:exported="false" />
        <activity android:name=".SettingsActivity" android:exported="false" />
        <activity android:name=".WorkoutDetailActivity" android:exported="false" />
        <activity android:name=".WorkoutSectionsActivity" android:exported="false" />
        <activity android:name=".WorkoutHubActivity" android:exported="false" />
        <activity android:name=".MovieDeckActivity" android:exported="false" />
        <!-- v3.11: the Circuits section (chooser door -> circuits home /
             motions A-Z -> circuit detail -> circuit player). -->
        <activity android:name=".CircuitsHomeActivity" android:exported="false" />
        <activity android:name=".CircuitMotionsActivity" android:exported="false" />
        <activity android:name=".CircuitDetailActivity" android:exported="false" />
        <activity android:name=".CircuitPlayerActivity" android:exported="false" />
        <activity android:name=".CardSessionActivity" android:exported="false" />
        <activity android:name=".SummaryActivity" android:exported="false" />
        <activity android:name=".LibraryActivity" android:exported="false" />
        <activity android:name=".PreviewCardsActivity" android:exported="false" />
        <activity android:name=".PickPartsActivity" android:exported="false" />
        <activity android:name=".AssembleActivity" android:exported="false" />
        <activity android:name=".BodyPartDetailActivity" android:exported="false" />
        <!-- v3.4: Health Connect permissions rationale. The system opens
             this from the Health Connect permission flow (pre-Android 14)
             and from Health Connect's privacy settings (Android 14+). -->
        <activity android:name=".HealthRationaleActivity" android:exported="true">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity>
    </application>
</manifest>
